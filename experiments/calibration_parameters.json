{
    "project": "Robot Autoequilibrado con IA",
    "phase": 4,
    "description": "Coeficientes de Bias de Laboratorio - MPU6050 Preferido",
    "units": {
        "accelerometer": "m/s^2",
        "gyroscope": "rad/s"
    },
    "coefficients": {
        "bias_acc_x": 0.583814,
        "bias_acc_y": 0.124246,
        "bias_acc_z": 0.748841,
        "bias_gyr_x": -0.069378,
        "bias_gyr_y": 0.012485,
        "bias_gyr_z": -0.003735
    },
    "math_model": {
        "corrected_acceleration_x": "AccX_cruda - bias_acc_x",
        "corrected_acceleration_z": "AccZ_cruda - (bias_acc_z + 9.80665)",
        "corrected_gyroscope_y": "GyrY_cruda - bias_gyr_y",
        "pitch_estimation_formula": "atan2(corrected_acceleration_x, corrected_acceleration_z)"
    }
}